@@ -0,0 +1,323 @@
+//! M5Stack Cardputer ADV (Stamp-S3A), optionally with the TERM512 external display.
+//!
+//! Pins are taken from the libraries the firmware links, at the revisions AREA512 pins them
+//! (M5GFX 27e1ef0, M5Unified 8108bfa) and from AREA512's own HAL:
+//!
+//! - Built-in 1.14" ST7789V2, 135x240 behind a 240x320 controller RAM (offset 52, 40):
+//!   MOSI 35, SCLK 36, DC 34, CS 37, RST 33, backlight 38 (`M5GFX.cpp`, `board_M5CardputerADV`).
+//!   M5GFX identifies the panel by reading RDDID (0x04) over 3-wire SPI and expects 0x81 or
+//!   0x85 in the first byte; it then tells the Cardputer from the ADV by reading GPIO 8/9 with
+//!   pull-downs, which the ADV's I2C pull-ups hold high.
+//! - TCA8418 keypad controller at 0x34 on the internal I2C, SDA 8 / SCL 9 (`M5Unified.cpp`,
+//!   AREA512 `console/keyboard.cpp`). Key event codes are `row * 10 + col + 1` of the
+//!   controller's matrix; AREA512's `cardputer_lookup_key` gives each its legend.
+//! - microSD (TF slot) on SPI2: SCLK 40, MOSI 14, MISO 39, CS 12 (AREA512 `sd/area512_sd.c`).
+//! - TERM512 CapTFT (AREA512 TFT builds only): a 240x320 ST7789 (or ILI9341) on SPI2 sharing
+//!   the card's bus, DC 6, CS 5, RST 3 (`captft/gfx/area512_display.cpp`).
+//!
+//! The board routes every SPI transaction by the chip selects that are low during it, so the
+//! panel, the card and the external display can share hosts the way the firmware shares them.
+use esp_soc::board::{BoardModel, SpiPins};
+use esp_soc::devices::{DcsPanel, SdCard};
+use crate::i2c::I2cDevice;
+use std::collections::VecDeque;
+use std::sync::{Arc, Mutex};
+
+pub const LCD_MOSI: u8 = 35;
+pub const LCD_SCLK: u8 = 36;
+pub const LCD_DC: u8 = 34;
+pub const LCD_CS: u8 = 37;
+pub const LCD_RST: u8 = 33;
+pub const LCD_BL: u8 = 38;
+pub const LCD_W: usize = 240;
+pub const LCD_H: usize = 135;
+
+pub const KBD_SDA: u8 = 8;
+pub const KBD_SCL: u8 = 9;
+pub const KBD_ADDR: u8 = 0x34;
+pub const KBD_INT: u8 = 11;
+
+pub const SD_SCLK: u8 = 40;
+pub const SD_MOSI: u8 = 14;
+pub const SD_MISO: u8 = 39;
+pub const SD_CS: u8 = 12;
+
+pub const EXT_DC: u8 = 6;
+pub const EXT_CS: u8 = 5;
+pub const EXT_RST: u8 = 3;
+
+pub const BTN_G0: u8 = 0;
+
+/// ST7789V2 RDDID: manufacturer 0x85, version 0x85, driver 0x52.
+const ST7789_ID: [u8; 3] = [0x85, 0x85, 0x52];
+
+/// TCA8418 register file and key event FIFO (TI SCPS215, section 8.6).
+#[derive(Default)]
+pub struct Tca8418State {
+    pub regs: [u8; 32],
+    pub fifo: VecDeque<u8>,
+    pub events: u64,
+}
+
+impl Tca8418State {
+    const CFG: usize = 0x01;
+    const INT_STAT: usize = 0x02;
+    const KEY_LCK_EC: usize = 0x03;
+    const KEY_EVENT_A: usize = 0x04;
+    const FIFO_DEPTH: usize = 10;
+
+    fn read(&mut self, reg: usize) -> u8 {
+        match reg {
+            Self::KEY_LCK_EC => (self.regs[reg] & 0xf0) | self.fifo.len() as u8,
+            Self::KEY_EVENT_A..=0x0d => {
+                // Reading KEY_EVENT_A pops the FIFO; 0 means empty.
+                if reg == Self::KEY_EVENT_A { self.fifo.pop_front().unwrap_or(0) } else { self.fifo.get(reg - Self::KEY_EVENT_A).copied().unwrap_or(0) }
+            }
+            Self::INT_STAT => self.regs[reg] | u8::from(!self.fifo.is_empty()),
+            r if r < self.regs.len() => self.regs[r],
+            _ => 0,
+        }
+    }
+
+    fn write(&mut self, reg: usize, v: u8) {
+        match reg {
+            Self::INT_STAT => self.regs[reg] &= !v,          // write 1 to clear
+            Self::KEY_EVENT_A..=0x0d => {}
+            r if r < self.regs.len() => self.regs[r] = v,
+            _ => {}
+        }
+    }
+
+    pub fn key(&mut self, code: u8, down: bool) {
+        if self.fifo.len() >= Self::FIFO_DEPTH {
+            self.regs[Self::INT_STAT] |= 0x08;              // OVR_FLOW_INT
+            return;
+        }
+        self.fifo.push_back((code & 0x7f) | if down { 0x80 } else { 0 });
+        self.regs[Self::INT_STAT] |= 0x01;                  // K_INT
+        self.events += 1;
+    }
+}
+
+/// The TCA8418 as seen from the I2C controller. Register writes are `reg, value...`; reads
+/// return the register selected by the last write, auto-incrementing when CFG.AI is set
+/// (except on the FIFO, which every read pops).
+pub struct Tca8418 { state: Arc<Mutex<Tca8418State>>, ptr: usize, first: bool }
+
+impl I2cDevice for Tca8418 {
+    fn pins(&self) -> Option<(u8, u8)> { Some((KBD_SDA, KBD_SCL)) }
+    fn start(&mut self, read: bool) -> bool { if !read { self.first = true; } true }
+    fn write(&mut self, b: u8) -> bool {
+        if self.first { self.ptr = b as usize; self.first = false; return true; }
+        let mut st = self.state.lock().unwrap();
+        st.write(self.ptr, b);
+        if st.regs[Tca8418State::CFG] & 0x80 != 0 { self.ptr = (self.ptr + 1) % 32; }
+        true
+    }
+    fn read(&mut self) -> u8 {
+        let mut st = self.state.lock().unwrap();
+        let v = st.read(self.ptr);
+        if st.regs[Tca8418State::CFG] & 0x80 != 0 && self.ptr != Tca8418State::KEY_EVENT_A { self.ptr = (self.ptr + 1) % 32; }
+        v
+    }
+}
+
+/// One ST7789 on an SPI chip select: the D/C line, reset, and the reply to register reads.
+struct Panel {
+    dcs: DcsPanel,
+    in_reset: bool,
+    /// The last command byte, so a following read knows what to return.
+    last_cmd: u8,
+}
+
+impl Panel {
+    fn new() -> Self { Panel { dcs: DcsPanel::st7789(), in_reset: false, last_cmd: 0 } }
+    fn transfer(&mut self, tx: &[u8], rx_len: usize) -> Vec<u8> {
+        if !self.in_reset {
+            for &b in tx {
+                if !self.dcs.dc { self.last_cmd = b; }
+                self.dcs.byte(b);
+            }
+        }
+        if rx_len == 0 { return Vec::new(); }
+        match self.last_cmd {
+            0x04 => ST7789_ID.iter().copied().chain(std::iter::repeat(0)).take(rx_len).collect(),
+            0xda => vec![ST7789_ID[0]; rx_len],
+            0xdb => vec![ST7789_ID[1]; rx_len],
+            0xdc => vec![ST7789_ID[2]; rx_len],
+            _ => vec![0; rx_len],
+        }
+    }
+}
+
+pub struct CardputerAdv {
+    lcd: Panel,
+    ext: Panel,
+    pub sd: SdCard,
+    sd_selected: bool,
+    kbd: Arc<Mutex<Tca8418State>>,
+    backlight: bool,
+    gpio_events: u64,
+}
+
+impl Default for CardputerAdv { fn default() -> Self { Self::new() } }
+
+impl CardputerAdv {
+    pub fn new() -> Self {
+        CardputerAdv {
+            lcd: Panel::new(), ext: Panel::new(), sd: SdCard::new(Vec::new()), sd_selected: false,
+            kbd: Arc::new(Mutex::new(Tca8418State::default())), backlight: false, gpio_events: 0,
+        }
+    }
+
+    /// What the Cardputer's glass shows, 240x135 landscape. With M5GFX's rotation 1 the app's x
+    /// runs down controller rows 40..280 and its y runs right to left across columns 52..187.
+    pub fn lcd_frame(&self) -> Vec<u16> {
+        let p = &self.lcd.dcs;
+        let mut out = vec![0u16; LCD_W * LCD_H];
+        // The panel glass is inverted: the firmware sends INVON so pixels come out as sent.
+        let invert = !p.inverted;
+        let dark = !p.on || p.sleeping;
+        for y in 0..LCD_H {
+            for x in 0..LCD_W {
+                let px = if dark { 0 } else {
+                    let v = p.gram[(40 + x) * p.cols + (186 - y)];
+                    if invert { !v } else { v }
+                };
+                out[y * LCD_W + x] = px;
+            }
+        }
+        out
+    }
+
+    /// The TERM512 panel, 320x240, read back through the MADCTL the firmware set: the firmware
+    /// chooses MADCTL so that its app coordinates are upright on the glass.
+    pub fn ext_frame(&self) -> (usize, usize, Vec<u16>) {
+        let p = &self.ext.dcs;
+        let mv = p.madctl & 0x20 != 0;
+        let (w, h) = if mv { (p.rows, p.cols) } else { (p.cols, p.rows) };
+        let mut out = vec![0u16; w * h];
+        for y in 0..h {
+            for x in 0..w {
+                let (mut col, mut row) = if mv { (y, x) } else { (x, y) };
+                if p.madctl & 0x40 != 0 { col = p.cols - 1 - col; }
+                if p.madctl & 0x80 != 0 { row = p.rows - 1 - row; }
+                let v = p.gram[row * p.cols + col];
+                out[y * w + x] = if p.inverted { !v } else { v };
+            }
+        }
+        (w, h, out)
+    }
+}
+
+impl BoardModel for CardputerAdv {
+    fn name(&self) -> &'static str { "cardputer-adv" }
+
+    fn gpio_changes(&mut self, changes: &[(u8, bool)]) {
+        for &(pin, level) in changes {
+            self.gpio_events += 1;
+            match pin {
+                LCD_DC => self.lcd.dcs.dc = level,
+                LCD_RST => { self.lcd.in_reset = !level; if !level { self.lcd.dcs.reset(); } }
+                LCD_BL => self.backlight = level,
+                EXT_DC => self.ext.dcs.dc = level,
+                EXT_RST => { self.ext.in_reset = !level; if !level { self.ext.dcs.reset(); } }
+                SD_CS if level => { self.sd.deselect(); self.sd_selected = false; }
+                _ => {}
+            }
+        }
+    }
+
+    fn uses_spi_pins(&self) -> bool { true }
+
+    fn spi_transfer_pins(&mut self, _host: u8, pins: SpiPins, tx: &[u8], rx_len: usize) -> Vec<u8> {
+        let cs = |pin: u8| pins.cs & (1u64 << pin) != 0;
+        if cs(LCD_CS) { return self.lcd.transfer(tx, rx_len); }
+        if cs(EXT_CS) { return self.ext.transfer(tx, rx_len); }
+        if cs(SD_CS) {
+            self.sd_selected = true;
+            // Full duplex: MISO byte i is clocked out while MOSI byte i goes in. A read-only
+            // phase longer than the write side clocks 0xff, the idle MOSI level.
+            let n = tx.len().max(rx_len);
+            let rx: Vec<u8> = (0..n).map(|i| self.sd.exchange(tx.get(i).copied().unwrap_or(0xff))).collect();
+            // A half-duplex read follows the written bytes on the wire.
+            return if rx_len != 0 && rx_len < n { rx[n - rx_len..].to_vec() } else { rx };
+        }
+        // Nothing selected: the card's clock-out before CMD0 (CS high) and anything else.
+        if self.sd_selected { self.sd.deselect(); self.sd_selected = false; }
+        vec![0xff; rx_len]
+    }
+
+    fn i2c_devices(&mut self) -> Vec<(u8, u8, Box<dyn I2cDevice>)> {
+        // Pinned to SDA 8 / SCL 9: whichever controller the firmware routes there finds it.
+        (0..2).map(|bus| (bus, KBD_ADDR, Box::new(Tca8418 { state: self.kbd.clone(), ptr: 0, first: true }) as Box<dyn I2cDevice>)).collect()
+    }
+
+    fn input_levels(&self) -> Vec<(u8, bool)> {
+        // GPIO 8/9 high (I2C pull-ups: the ADV), 5/6 low (nothing there), G0 released,
+        // keypad INT idle high.
+        vec![(KBD_SDA, true), (KBD_SCL, true), (5, false), (6, false), (BTN_G0, true), (KBD_INT, true), (SD_MISO, true)]
+    }
+
+    fn key_event(&mut self, code: u8, down: bool) { self.kbd.lock().unwrap().key(code, down); }
+
+    fn set_sd_image(&mut self, image: Vec<u8>) { self.sd = SdCard::new(image); self.sd_selected = false; }
+    fn sd_image(&self) -> Option<&[u8]> { self.sd.is_present().then(|| self.sd.image()) }
+    fn sd_generation(&self) -> u64 { self.sd.write_generation }
+
+    fn gpio_events(&self) -> u64 { self.gpio_events }
+    fn named_pin(&self, name: &str) -> Option<u8> { match name { "g0" | "btn1" | "boot" => Some(BTN_G0), _ => None } }
+
+    fn display(&self) -> Option<(u32, u32, Vec<u16>, u64)> {
+        Some((LCD_W as u32, LCD_H as u32, self.lcd_frame(), self.display_version()))
+    }
+    fn display_version(&self) -> u64 {
+        let p = &self.lcd.dcs;
+        p.pixels_written + p.resets * 7 + u64::from(p.on) * 3 + u64::from(p.sleeping) * 5 + u64::from(p.inverted)
+    }
+    fn display_frames(&self) -> u64 { self.lcd.dcs.frames }
+    fn display_quiet_push(&self) -> bool { true }
+    fn display_aux(&self) -> Option<(u32, u32, Vec<u16>, u64)> {
+        if self.ext.dcs.pixels_written == 0 { return None; }
+        let (w, h, px) = self.ext_frame();
+        Some((w as u32, h as u32, px, self.ext.dcs.pixels_written))
+    }
+    fn display_aux_version(&self) -> u64 { self.ext.dcs.pixels_written }
+    fn gram(&self) -> Option<(Vec<u16>, usize, usize)> { Some((self.lcd.dcs.gram.clone(), self.lcd.dcs.cols, self.lcd.dcs.rows)) }
+
+    fn report(&self) -> String {
+        let k = self.kbd.lock().unwrap();
+        format!("[emu] lcd: {} RAMWR, {} pixels, madctl={:#x} inv={} on={}; ext: {} pixels\n[emu] sd: {} sectors, {} commands, {} blocks read, {} written, {} crc errors\n[emu] keyboard: {} events, cfg={:#x}",
+                self.lcd.dcs.frames, self.lcd.dcs.pixels_written, self.lcd.dcs.madctl, self.lcd.dcs.inverted, self.lcd.dcs.on,
+                self.ext.dcs.pixels_written, self.sd.sectors(), self.sd.commands, self.sd.blocks_read, self.sd.blocks_written, self.sd.crc_errors,
+                k.events, k.regs[1])
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn keypad_fifo_pops_and_flags_interrupt() {
+        let mut st = Tca8418State::default();
+        assert_eq!(st.read(0x02) & 1, 0);
+        st.key(13, true);
+        st.key(13, false);
+        assert_eq!(st.read(0x02) & 1, 1);
+        assert_eq!(st.read(0x03) & 0x0f, 2);
+        assert_eq!(st.read(0x04), 0x80 | 13);
+        assert_eq!(st.read(0x04), 13);
+        assert_eq!(st.read(0x04), 0);
+    }
+
+    #[test]
+    fn panel_answers_rddid() {
+        let mut b = CardputerAdv::new();
+        b.gpio_changes(&[(LCD_DC, false)]);
+        let pins = SpiPins { cs: 1 << LCD_CS, ..Default::default() };
+        b.spi_transfer_pins(2, pins, &[0x04], 0);
+        let id = b.spi_transfer_pins(2, pins, &[], 4);
+        assert_eq!(id[0] & 0xfb, 0x81);
+    }
+}
