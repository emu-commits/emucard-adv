diff --git a/esp-soc/src/devices/sd_spi.rs b/esp-soc/src/devices/sd_spi.rs
new file mode 100644
index 00000000..5d225bc1
--- /dev/null
+++ b/esp-soc/src/devices/sd_spi.rs
@@ -0,0 +1,391 @@
+//! An SD card (SDHC, block addressed) in SPI mode, as the ESP-IDF `sdspi` host drives it.
+//!
+//! The card is a byte pump: every byte the host clocks out on MOSI is answered by one byte on
+//! MISO, the next one the card has queued (or `0xff`, the idle level, when it has nothing to
+//! say). What it queues follows the SD Physical Layer Simplified Specification, section 7 (SPI
+//! mode): a 6-byte command token `01cccccc aaaaaaaa*4 crc7<<1|1`, then after one byte of Ncr the
+//! response (R1, R1b, R2, R3 or R7), and for data commands a start token (`0xfe`) with the block
+//! and its CRC16. Writes arrive the same way in the other direction and are answered with a data
+//! response token and a short busy period.
+//!
+//! The card image is a plain byte vector of whole 512-byte sectors. Its size must be a multiple
+//! of 512 KiB so the CSD version 2.0 C_SIZE field describes it exactly.
+
+const BLOCK: usize = 512;
+
+/// R1 bits.
+const R1_IDLE: u8 = 0x01;
+const R1_ILLEGAL: u8 = 0x04;
+const R1_PARAM: u8 = 0x40;
+const R1_ADDRESS: u8 = 0x20;
+
+/// CRC7 as used by command tokens and the CID/CSD registers (polynomial x^7 + x^3 + 1).
+pub fn crc7(data: &[u8]) -> u8 {
+    let mut crc = 0u8;
+    for &byte in data {
+        for bit in (0..8).rev() {
+            let inb = (byte >> bit) & 1;
+            let top = (crc >> 6) & 1;
+            crc = (crc << 1) & 0x7f;
+            if inb ^ top != 0 { crc ^= 0x09; }
+        }
+    }
+    crc
+}
+
+/// CRC16-CCITT (polynomial 0x1021, initial 0), the data block CRC.
+pub fn crc16(data: &[u8]) -> u16 {
+    let mut crc = 0u16;
+    for &byte in data {
+        crc ^= (byte as u16) << 8;
+        for _ in 0..8 {
+            crc = if crc & 0x8000 != 0 { (crc << 1) ^ 0x1021 } else { crc << 1 };
+        }
+    }
+    crc
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Rx {
+    /// Waiting for a command token (or idle 0xff).
+    Idle,
+    /// Collecting the six bytes of a command token.
+    Command,
+    /// CMD24 / CMD25 accepted: waiting for a data start token.
+    WriteToken { multi: bool },
+    /// Collecting a data block (512 bytes + CRC16).
+    WriteData { multi: bool },
+}
+
+pub struct SdCard {
+    image: Vec<u8>,
+    out: std::collections::VecDeque<u8>,
+    rx: Rx,
+    token: [u8; 6],
+    token_len: usize,
+    block: Vec<u8>,
+    /// Sector being transferred (reads and writes).
+    sector: u64,
+    /// Multi-block read in progress: the next block is queued whenever the output drains.
+    reading: bool,
+    idle: bool,
+    app_cmd: bool,
+    crc_on: bool,
+    /// Commands seen, for diagnostics (index per command, saturating).
+    pub commands: u64,
+    pub blocks_read: u64,
+    pub blocks_written: u64,
+    /// Bumped on every write so a host can tell the image changed.
+    pub write_generation: u64,
+    pub crc_errors: u64,
+}
+
+impl SdCard {
+    pub fn new(image: Vec<u8>) -> Self {
+        SdCard {
+            image, out: Default::default(), rx: Rx::Idle, token: [0; 6], token_len: 0, block: Vec::new(),
+            sector: 0, reading: false, idle: true, app_cmd: false, crc_on: false,
+            commands: 0, blocks_read: 0, blocks_written: 0, write_generation: 0, crc_errors: 0,
+        }
+    }
+
+    pub fn image(&self) -> &[u8] { &self.image }
+    pub fn sectors(&self) -> u64 { (self.image.len() / BLOCK) as u64 }
+    pub fn is_present(&self) -> bool { !self.image.is_empty() }
+
+    /// CS went high: the card stops driving MISO and drops any half-received token. A write that
+    /// was waiting for its data token is abandoned, as the host only deselects after the data.
+    pub fn deselect(&mut self) {
+        self.out.clear();
+        self.token_len = 0;
+        self.reading = false;
+        if matches!(self.rx, Rx::Command | Rx::WriteData { .. }) { self.rx = Rx::Idle; }
+    }
+
+    /// One full-duplex byte: returns what the card drives on MISO while `mosi` is shifted in.
+    pub fn exchange(&mut self, mosi: u8) -> u8 {
+        if !self.is_present() { return 0xff; }
+        let miso = self.out.pop_front().unwrap_or(0xff);
+        self.input(mosi);
+        if self.reading && self.out.is_empty() { self.queue_read_block(); }
+        miso
+    }
+
+    fn input(&mut self, b: u8) {
+        match self.rx {
+            Rx::Idle | Rx::Command if self.token_len == 0 => {
+                // A command starts with start bit 0, transmission bit 1.
+                if b & 0xc0 == 0x40 {
+                    self.token[0] = b;
+                    self.token_len = 1;
+                    self.rx = Rx::Command;
+                }
+            }
+            Rx::Idle | Rx::Command => {
+                self.token[self.token_len] = b;
+                self.token_len += 1;
+                if self.token_len == 6 {
+                    self.token_len = 0;
+                    self.rx = Rx::Idle;
+                    self.command();
+                }
+            }
+            Rx::WriteToken { multi } => {
+                if b == 0xfe || (multi && b == 0xfc) {
+                    self.block.clear();
+                    self.rx = Rx::WriteData { multi };
+                } else if multi && b == 0xfd {
+                    // Stop Tran: a byte of busy, then idle.
+                    self.rx = Rx::Idle;
+                    self.out.extend([0xff, 0x00, 0x00]);
+                } else if b & 0xc0 == 0x40 {
+                    // A command instead of data (CMD12 or a host giving up): handle it.
+                    self.rx = Rx::Command;
+                    self.token[0] = b;
+                    self.token_len = 1;
+                }
+            }
+            Rx::WriteData { multi } => {
+                self.block.push(b);
+                if self.block.len() == BLOCK + 2 {
+                    let ok = self.write_block();
+                    // Data response token xxx0sss1: 010 accepted, 101 CRC error, 110 write error.
+                    self.out.push_back(match ok { Ok(()) => 0x05, Err(true) => 0x0b, Err(false) => 0x0d });
+                    self.out.extend([0x00, 0x00, 0x00]);           // programming: busy
+                    self.rx = if multi && ok.is_ok() { Rx::WriteToken { multi } } else { Rx::Idle };
+                }
+            }
+        }
+    }
+
+    /// Ok, or Err(true) for a CRC error / Err(false) for an address error.
+    fn write_block(&mut self) -> Result<(), bool> {
+        let data = &self.block[..BLOCK];
+        if self.crc_on {
+            let crc = u16::from_be_bytes([self.block[BLOCK], self.block[BLOCK + 1]]);
+            if crc != crc16(data) { self.crc_errors += 1; return Err(true); }
+        }
+        let off = self.sector as usize * BLOCK;
+        if off + BLOCK > self.image.len() { return Err(false); }
+        self.image[off..off + BLOCK].copy_from_slice(data);
+        self.sector += 1;
+        self.blocks_written += 1;
+        self.write_generation += 1;
+        Ok(())
+    }
+
+    fn r1(&self) -> u8 { if self.idle { R1_IDLE } else { 0 } }
+
+    fn respond(&mut self, bytes: &[u8]) {
+        self.out.clear();
+        self.out.push_back(0xff);                                // Ncr: one byte
+        self.out.extend(bytes.iter().copied());
+    }
+
+    fn data_block(&mut self, data: &[u8]) {
+        self.out.push_back(0xff);                                // Nac
+        self.out.push_back(0xfe);
+        self.out.extend(data.iter().copied());
+        self.out.extend(crc16(data).to_be_bytes());
+    }
+
+    fn queue_read_block(&mut self) {
+        let off = self.sector as usize * BLOCK;
+        if off + BLOCK > self.image.len() {
+            self.reading = false;
+            self.out.push_back(0x09);                             // data error token: out of range
+            return;
+        }
+        let block = self.image[off..off + BLOCK].to_vec();
+        self.data_block(&block);
+        self.sector += 1;
+        self.blocks_read += 1;
+    }
+
+    fn command(&mut self) {
+        self.commands += 1;
+        let cmd = self.token[0] & 0x3f;
+        let arg = u32::from_be_bytes([self.token[1], self.token[2], self.token[3], self.token[4]]);
+        // CRC is mandatory for CMD0 and CMD8 even with CRC off; the host always sends it, so the
+        // card checks it whenever the host has turned checking on, and for those two always.
+        let crc_ok = (crc7(&self.token[..5]) << 1 | 1) == self.token[5];
+        if !crc_ok && (self.crc_on || cmd == 0 || cmd == 8) {
+            self.crc_errors += 1;
+            self.app_cmd = false;
+            self.respond(&[self.r1() | 0x08]);                   // COM_CRC_ERROR
+            return;
+        }
+        let app = std::mem::take(&mut self.app_cmd);
+        if cmd != 12 { self.reading = false; }
+        if app {
+            match cmd {
+                41 => { self.idle = false; self.respond(&[0x00]); }
+                51 => { let r = self.r1(); self.respond(&[r]); self.data_block(&[0x02, 0x35, 0x80, 0x00, 0, 0, 0, 0]); }
+                13 => { let r = self.r1(); self.respond(&[r, 0x00]); self.data_block(&Self::sd_status()); }
+                22 => { let r = self.r1(); self.respond(&[r]); let n = (self.blocks_written as u32).to_be_bytes(); self.data_block(&n); }
+                23 | 42 => { let r = self.r1(); self.respond(&[r]); }
+                _ => { let r = self.r1(); self.respond(&[r | R1_ILLEGAL]); }
+            }
+            return;
+        }
+        let r1 = self.r1();
+        match cmd {
+            0 => { self.idle = true; self.rx = Rx::Idle; self.respond(&[R1_IDLE]); }
+            8 => { self.respond(&[r1, 0x00, 0x00, (arg >> 8) as u8 & 0x0f, arg as u8]); }
+            58 => {
+                // OCR: powered up (bit 31) once initialised, CCS (bit 30, SDHC), 2.7-3.6 V.
+                let ocr: u32 = if self.idle { 0x00ff_8000 } else { 0xc0ff_8000 };
+                let mut r = vec![r1];
+                r.extend(ocr.to_be_bytes());
+                self.respond(&r);
+            }
+            59 => { self.crc_on = arg & 1 != 0; self.respond(&[r1]); }
+            55 => { self.app_cmd = true; self.respond(&[r1]); }
+            1 => { self.idle = false; self.respond(&[0x00]); }
+            9 => { self.respond(&[r1]); let csd = self.csd(); self.data_block(&csd); }
+            10 => { self.respond(&[r1]); let cid = Self::cid(); self.data_block(&cid); }
+            13 => { self.respond(&[r1, 0x00]); }
+            16 => { self.respond(&[if arg as usize == BLOCK { r1 } else { r1 | R1_PARAM }]); }
+            6 => { self.respond(&[r1]); self.data_block(&Self::switch_status(arg)); }
+            12 => {
+                // Stop: a stuff byte, R1, then busy.
+                self.reading = false;
+                self.out.clear();
+                self.out.extend([0xff, 0xff, r1, 0x00, 0xff]);
+            }
+            17 | 18 => {
+                if u64::from(arg) >= self.sectors() { self.respond(&[r1 | R1_ADDRESS]); return; }
+                self.sector = u64::from(arg);
+                self.respond(&[r1]);
+                self.queue_read_block();
+                self.reading = cmd == 18;
+            }
+            24 | 25 => {
+                if u64::from(arg) >= self.sectors() { self.respond(&[r1 | R1_ADDRESS]); return; }
+                self.sector = u64::from(arg);
+                self.respond(&[r1]);
+                self.rx = Rx::WriteToken { multi: cmd == 25 };
+            }
+            32 | 33 => { self.respond(&[r1]); }
+            38 => { self.respond(&[r1, 0x00, 0x00]); }
+            _ => { self.respond(&[r1 | R1_ILLEGAL]); }
+        }
+    }
+
+    /// CSD version 2.0 (SDHC): C_SIZE = sectors / 1024 - 1.
+    fn csd(&self) -> [u8; 16] {
+        let c_size = (self.sectors() / 1024).saturating_sub(1) as u32;
+        let mut csd = [0x40, 0x0e, 0x00, 0x32, 0x5b, 0x59, 0x00,
+                       ((c_size >> 16) & 0x3f) as u8, (c_size >> 8) as u8, c_size as u8,
+                       0x7f, 0x80, 0x0a, 0x40, 0x00, 0x00];
+        csd[15] = crc7(&csd[..15]) << 1 | 1;
+        csd
+    }
+
+    fn cid() -> [u8; 16] {
+        // MID 0x45 OID "EM" PNM "EMUSD" PRV 1.0 PSN 0x12345678 MDT 2026-10
+        let mut cid = [0x45, b'E', b'M', b'E', b'M', b'U', b'S', b'D', 0x10, 0x12, 0x34, 0x56, 0x78, 0x01, 0x6a, 0];
+        cid[15] = crc7(&cid[..15]) << 1 | 1;
+        cid
+    }
+
+    fn sd_status() -> [u8; 64] {
+        let mut s = [0u8; 64];
+        s[8] = 0x02;          // SPEED_CLASS 4
+        s[10] = 0x90;         // AU_SIZE 4 MiB
+        s
+    }
+
+    /// CMD6 status: only function 0 (default speed) and 1 (high speed) of group 1 exist.
+    fn switch_status(arg: u32) -> [u8; 64] {
+        let mut s = [0u8; 64];
+        s[0] = 0x00; s[1] = 0x64;            // max current 100 mA
+        s[12] = 0x80; s[13] = 0x03;          // group 1 supports functions 0 and 1
+        let f = (arg & 0xf) as u8;
+        s[16] = if f == 0xf || f <= 1 { if f == 0xf { 0 } else { f } } else { 0xf };
+        s
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn token(cmd: u8, arg: u32) -> [u8; 6] {
+        let mut t = [0x40 | cmd, (arg >> 24) as u8, (arg >> 16) as u8, (arg >> 8) as u8, arg as u8, 0];
+        t[5] = crc7(&t[..5]) << 1 | 1;
+        t
+    }
+
+    /// Send a token then `n` idle bytes, returning everything read back after the token.
+    fn cmd(card: &mut SdCard, cmd: u8, arg: u32, n: usize) -> Vec<u8> {
+        for b in token(cmd, arg) { card.exchange(b); }
+        (0..n).map(|_| card.exchange(0xff)).collect()
+    }
+
+    fn r1(reply: &[u8]) -> u8 { *reply.iter().find(|&&b| b != 0xff).unwrap() }
+
+    fn init(card: &mut SdCard) {
+        assert_eq!(r1(&cmd(card, 0, 0, 8)), 0x01);
+        let r7 = cmd(card, 8, 0x1aa, 8);
+        assert_eq!(&r7[1..6], &[0x01, 0, 0, 0x01, 0xaa]);
+        assert_eq!(r1(&cmd(card, 59, 1, 8)), 0x01);
+        assert_eq!(r1(&cmd(card, 55, 0, 8)), 0x01);
+        assert_eq!(r1(&cmd(card, 41, 0x4000_0000, 8)), 0x00);
+        let r3 = cmd(card, 58, 0, 8);
+        assert_eq!(&r3[1..6], &[0x00, 0xc0, 0xff, 0x80, 0x00]);
+    }
+
+    #[test]
+    fn known_crcs() {
+        assert_eq!(token(0, 0)[5], 0x95);
+        assert_eq!(token(8, 0x1aa)[5], 0x87);
+        assert_eq!(crc16(&[0xff; 512]), 0x7fa1);
+    }
+
+    #[test]
+    fn initialises_and_reads_csd_and_blocks() {
+        let mut img = vec![0u8; 1024 * 1024];
+        img[512..1024].fill(0xab);
+        let mut card = SdCard::new(img);
+        init(&mut card);
+        let csd = cmd(&mut card, 9, 0, 24);
+        let start = csd.iter().position(|&b| b == 0xfe).unwrap();
+        assert_eq!(csd[start + 1], 0x40);
+        assert_eq!(&csd[start + 8..start + 11], &[0x00, 0x00, 0x01], "C_SIZE 1 = 1 MiB");
+        let rd = cmd(&mut card, 17, 1, 530);
+        let start = rd.iter().position(|&b| b == 0xfe).unwrap();
+        assert!(rd[start + 1..start + 513].iter().all(|&b| b == 0xab));
+        assert_eq!(u16::from_be_bytes([rd[start + 513], rd[start + 514]]), crc16(&[0xab; 512]));
+    }
+
+    #[test]
+    fn writes_a_block_with_crc() {
+        let mut card = SdCard::new(vec![0u8; 512 * 1024]);
+        init(&mut card);
+        assert_eq!(r1(&cmd(&mut card, 24, 3, 4)), 0x00);
+        card.exchange(0xfe);
+        for _ in 0..512 { card.exchange(0x5a); }
+        let crc = crc16(&[0x5a; 512]).to_be_bytes();
+        card.exchange(crc[0]);
+        card.exchange(crc[1]);
+        let resp: Vec<u8> = (0..6).map(|_| card.exchange(0xff)).collect();
+        assert_eq!(resp[0] & 0x1f, 0x05, "{resp:02x?}");
+        assert!(card.image()[3 * 512..4 * 512].iter().all(|&b| b == 0x5a));
+        assert_eq!(card.write_generation, 1);
+    }
+
+    #[test]
+    fn multi_block_read_stops_on_cmd12() {
+        let mut card = SdCard::new((0..512 * 1024).map(|i| (i / 512) as u8).collect());
+        init(&mut card);
+        let rd = cmd(&mut card, 18, 2, 1100);
+        let blocks: Vec<usize> = rd.windows(2).enumerate().filter(|(_, w)| w[0] == 0xff && w[1] == 0xfe).map(|(i, _)| i + 1).collect();
+        assert!(blocks.len() >= 2);
+        assert_eq!(rd[blocks[0] + 1], 2);
+        assert_eq!(rd[blocks[1] + 1], 3);
+        let stop = cmd(&mut card, 12, 0, 8);
+        assert_eq!(r1(&stop[1..]), 0x00);
+        assert!(!card.reading);
+    }
+}
