+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_sd_ptr(e: *mut Emu) -> *const u8 {
+    // SAFETY: The caller provides shared access to a live emulator without overlapping mutation.
+    unsafe { &*e }.m.sd_image().map_or(std::ptr::null(), |d| d.as_ptr())
+}
+/// Length of the memory card image, 0 when there is no card.
