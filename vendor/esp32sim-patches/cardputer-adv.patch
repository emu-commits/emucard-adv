+/// Spin skip: park a core that keeps yielding to itself without device access until its next
+/// interrupt (`Machine::set_spin_skip`). Off by default.
+///
+/// # Safety
+/// `e` must point to a live emulator to which the caller has exclusive access.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_set_spin_skip(e: *mut Emu, on: u32) {
+    // SAFETY: The caller provides exclusive access to a live emulator.
+    unsafe { &mut *e }.m.set_spin_skip(on != 0);
+}
+
+/// A key of the board's keyboard went down (`down` = 1) or up. `code` is the board's key number:
+/// on `cardputer-adv`, the TCA8418 key event code.
+///
+/// # Safety
+/// `e` must point to a live emulator to which the caller has exclusive access.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_key(e: *mut Emu, code: u32, down: u32) {
+    // SAFETY: The caller provides exclusive access to a live emulator.
+    unsafe { &mut *e }.m.key_event(code as u8, down != 0);
+}
+
+/// The memory card's contents (null when there is no card): valid until the next call that runs
+/// the machine. Copy it out with `esp32sim_sd_len` bytes.
